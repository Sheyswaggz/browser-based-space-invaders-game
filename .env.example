# Environment Configuration for Space Invaders Game
# Copy this file to .env for local development: cp .env.example .env

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable the game canvas rendering
# Set to 'false' to disable the game (kill switch)
# Values: true, false
# Default: true
ENABLE_GAME_CANVAS=true

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================

# Node environment
# Values: development, production, test
# Default: development
NODE_ENV=development

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Local development server port
# The port on which the development server will run
# Values: 1024-65535
# Default: 8080
PORT=8080

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable debug mode for additional console logging
# Set to 'true' to see detailed game state and performance logs
# Values: true, false
# Default: false
DEBUG_MODE=false

# Enable performance monitoring
# Set to 'true' to log frame rates and render times
# Values: true, false
# Default: false
ENABLE_PERFORMANCE_MONITORING=false

# ============================================================================
# GAME CONFIGURATION
# ============================================================================

# Target frames per second for game loop
# Values: 30, 60, 120
# Default: 60
TARGET_FPS=60

# Enable sound effects
# Set to 'false' to disable all game sounds
# Values: true, false
# Default: true
ENABLE_SOUND=true

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Test environment timeout in milliseconds
# Increase if tests are timing out
# Values: positive integer
# Default: 5000
TEST_TIMEOUT=5000

# Enable test coverage reporting
# Values: true, false
# Default: true
ENABLE_COVERAGE=true

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

# Enable source maps in production build
# Set to 'true' for easier debugging in production
# Values: true, false
# Default: false
ENABLE_SOURCE_MAPS=false

# Minify production build
# Set to 'false' to disable minification for debugging
# Values: true, false
# Default: true
ENABLE_MINIFICATION=true

# ============================================================================
# NOTES
# ============================================================================
# - This file should NOT contain sensitive information or secrets
# - All values are optional and will fall back to defaults if not set
# - Boolean values should be lowercase: true or false
# - Changes to this file require restarting the development server
# - The .env file is gitignored and should not be committed to version control